# --- BigQuery credentials (pick ONE) ---
# Path to the read-only service-account JSON:
#   claude-code-bq-readonly@biom-reporting-s26.iam.gserviceaccount.com
#   (dataViewer + jobUser: reads everything, writes nothing)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/claude-code-bq-readonly.json
#
# ...or the same JSON base64-encoded, for launchers that can only pass strings.
# The server materializes it to ~/.config/gcloud/biom-bq-sa.json at mode 0600
# and never logs or returns the key bytes.
# GCP_SA_KEY_B64=

# --- BigQuery target ---
BPD_BQ_PROJECT=biom-reporting-s26
# REQUIRED. An empty location does not error — it makes INFORMATION_SCHEMA
# silently return zero rows, which presents as "the table has no columns".
BPD_BQ_LOCATION=us-central1

# --- Cost controls (BigQuery bills by byte scanned) ---
# Hard maximum_bytes_billed on every job. 20 GiB.
BPD_BQ_MAX_BYTES_BILLED=21474836480
# The pre-flight dry-run gate logs a warning above this. 1 GiB.
BPD_BQ_WARN_BYTES=1073741824
# TTL for the combined date-range sweep — the one metadata query that costs
# money (~527 MB per refresh).
BPD_BQ_DATERANGE_TTL_S=900
# TTL for __TABLES__ row counts (0 bytes; the TTL only keeps them moving).
BPD_BQ_ROWCOUNT_TTL_S=300
# Row cap for bpd_export_query_to_csv.
BPD_EXPORT_MAX_ROWS=200000

# --- Vendor identity ---
BPD_VENDOR_ID=139440
BPD_VENDOR_TIER=BV

# --- Local storage (OUTPUTS ONLY: exports/ and logs/. There is no local data store.) ---
BPD_DATA_DIR=~/.bpd-mcp

# --- Behavior ---
BPD_LOG_LEVEL=INFO

# --- RETIRED: Kiteworks ingest ---
# The server no longer downloads or parses anything; an independent
# Kiteworks -> GCS -> BigQuery pipeline lands the same 834 files daily around
# 06:47 UTC. None of the settings below are read any more.
#
# TODO: rotate, deferred. These client credentials are committed to the repo
# and were live at the time this file was written. Rotating them with Target is
# out of scope for the BigQuery migration and was explicitly deferred; they are
# left verbatim rather than quietly deleted so the rotation task stays visible.
# KITEWORKS_BASE_URL=https://securesharek.target.com
# KITEWORKS_USERNAME=
# KITEWORKS_PASSWORD=
# KITEWORKS_CLIENT_ID=1c9f2b24-847e-5ee6-acc4-f03c8da0cfba
# KITEWORKS_CLIENT_SECRET=2bLyg*oqja
# KITEWORKS_OAUTH_SCOPE=*/*/*
# KITEWORKS_API_VERSION=15
