<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job: run `bpd-sync` every morning (Patch #15).

  Do not edit this file in place — it is a TEMPLATE. Run
  scripts/install_launchd.sh, which substitutes __REPO_DIR__ / __UV_BIN__ /
  __HOME__ / __HOUR__ / __MINUTE__ and installs the result to
  ~/Library/LaunchAgents/com.biom.bpd-sync.plist.

  Notes:
    * RunAtLoad is false on purpose — installing the job should not kick off a
      sync you did not ask for. Use `launchctl kickstart` to test.
    * Credentials are NOT stored here. `bpd-sync` reads the repo's .env and the
      cached refresh token at ~/.bpd-mcp/tokens.json (0600).
    * Exit code 75 means the warehouse was locked by the running MCP server;
      the run was skipped and the next one picks the work up.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.biom.bpd-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_BIN__</string>
        <string>run</string>
        <string>--directory</string>
        <string>__REPO_DIR__</string>
        <string>bpd-sync</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__HOUR__</integer>
        <key>Minute</key>
        <integer>__MINUTE__</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Run even if the scheduled time was missed while the Mac was asleep. -->
    <key>StartInterval</key>
    <integer>0</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.bpd-mcp/logs/bpd-sync.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.bpd-mcp/logs/bpd-sync.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
